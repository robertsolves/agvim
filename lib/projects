#!/bin/zsh
# projects: the projects bar, the tabs along the top (tmux/projects.conf). Each
# of its tabs shows one project's tmux session.
#
#   projects                       show the bar in this terminal (`agvim continue`
#                                  runs this): this repo first, then a tab for
#                                  everything open last time, each started only when
#                                  you first look at it
#   projects show <name>           give project <name> a tab and show it
#   projects close <client> <id>   ask, then save and stop that tab's project
#   projects stop [--now]          when the last window has gone (the bar's hook):
#                                  save every project; with keep-running off, or
#                                  --now (agvim stop), also stop them
#   projects front                 bring the terminal you use to the front
#   projects new-terminal          open the workspace in a new window of your terminal
#                                  (lib/terminal)
#
# Used by agvim, open-project and the bar's x.

repo="${0:A:h:h}"
conf="$repo/tmux/projects.conf"
store="$repo/saved-projects"
bar() { command tmux -L projects "$@"; }
work() { env -u TMUX tmux "$@"; } # your tmux, where the projects run

# The app that this process runs in (kitty, iTerm, Terminal...), if any, so Finder's
# actions can use that one. A shell or login above it can have an app's path in its
# arguments, so what's before the path must be a real app folder.
terminal_app() {
  local pid=$$ cmd app
  while [ "$pid" -gt 1 ]; do
    cmd="$(ps -o command= -p "$pid")"
    app="${cmd%%.app/Contents/*}.app"
    if [[ "$cmd" == *.app/Contents/* && -d "$app" ]]; then
      print -r -- "$app"
      return
    fi
    pid="$(ps -o ppid= -p "$pid" | tr -d ' ')"
  done
}

# A tab for project $1, unless it has one. The bar always starts with this repo as
# its first tab, so you can get to it and update it from inside.
add() {
  bar list-windows -t '=projects' -F '#{window_name}' 2>/dev/null | grep -qxF -- "$1" && return
  if ! bar has-session -t '=projects' 2>/dev/null; then
    "$repo/lib/project" ensure-self
    bar -f "$conf" new-session -d -s projects -n agvim -x 200 -y 50 "$repo/lib/projects" run agvim
    keep_colour agvim
    [ "$1" = agvim ] && return
  fi
  bar new-window -d -t '=projects:' -n "$1" "$repo/lib/projects" run "$1"
  keep_colour "$1"
}

# The colour a project had last time (lib/project write_open), if it had one.
keep_colour() {
  local n
  [ -f "$store/.colours" ] || return 0
  n="$(awk -F'\t' -v p="$1" '$1 == p { print $2 }' "$store/.colours")"
  [ -n "$n" ] && "$repo/lib/colours" keep bar "=projects:=$1" "$n"
}

# Saves every minute while the bar is up, for a crash or a power cut. Changes to
# tabs also save within seconds (tmux.conf hooks, lib/project save-soon).
autosave() {
  local pid
  pid="$(bar show -gqv @autosave)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return
  {
    while sleep 60 && bar has-session -t '=projects' 2>/dev/null; do
      "$repo/lib/project" save-all
    done
  } >/dev/null 2>&1 </dev/null &!
  bar set -g @autosave "$!"
}

case "$1" in
  "")
    if [ -n "$TMUX" ] && [ -n "$(bar list-clients 2>/dev/null)" ]; then
      print -r -- "agvim is open already: + Project and + Shell are on its top bar."
      exit 0
    fi
    app="$(terminal_app)"
    if [ -n "$app" ]; then
      mkdir -p ~/.config/agvim
      print -r -- "$app" >~/.config/agvim/last-terminal
    fi
    work has-session 2>/dev/null && work source-file ~/.tmux.conf # pick up changes to it
    bar source-file "$conf" 2>/dev/null
    add agvim
    # Worktrees (@parent) are on the row under their project, not tabs of their own.
    for s in ${(f)"$(work list-sessions -F '#{session_name}	#{@parent}' 2>/dev/null | awk -F'\t' '$2 == "" { print $1 }')"}; do
      add "$s"
    done
    if [ -f "$store/.open" ]; then
      for s in ${(f)"$(<"$store/.open")"}; do
        # Only what can come back: a project, or a console with saved tabs.
        { [ -f "$store/$s" ] || [ -s "$store/.tabs/$s/tabs" ]; } && add "$s"
      done
      [ -f "$store/.active" ] && bar select-window -t "=projects:=$(<"$store/.active")" 2>/dev/null
    fi
    autosave
    "$repo/lib/attention" watch </dev/null >/dev/null 2>&1 &!
    # The worktree row under each project's name, which only a worktree event draws.
    for s in ${(f)"$(bar list-windows -t '=projects' -F '#{window_name}' 2>/dev/null)"}; do
      "$repo/lib/worktree" render "$s" >/dev/null 2>&1
    done
    exec env -u TMUX tmux -L projects attach -t '=projects'
    ;;
  run)
    # What a tab of the bar runs. Nothing starts until the tab is first looked at,
    # so opening the workspace doesn't start every project at once.
    name="$2"
    while true; do
      clear
      printf '%s is closed. It starts when you look at this tab.\n' "$name"
      until [ "$(bar display -p -t "$TMUX_PANE" '#{window_active}')" = 1 ]; do
        sleep 0.3
      done
      # Renamed while it waited (agvim rename): the tab has the name now.
      now="$(bar display -p -t "$TMUX_PANE" '#{window_name}')"
      [ -z "$now" ] || name="$now"
      if ! "$repo/lib/project" start "$name"; then
        sleep 5 # long enough to read why
        exit 1
      fi
      "$repo/lib/worktree" render "$name" >/dev/null 2>&1
      # Detaching the project's tmux (prefix d) would end this tab and drop the
      # project from the bar while it keeps running, so it attaches again. By id:
      # a renamed project is still the same session.
      sid="$(env -u TMUX tmux display -p -t "=$name:" '#{session_id}')"
      [ -n "$sid" ] || { sleep 1; continue; } # display-message prints nothing, and succeeds, for a missing target
      while env -u TMUX tmux has-session -t "$sid" 2>/dev/null; do
        env -u TMUX tmux attach -t "$sid" || sleep 1 # not a tight loop if it keeps failing
      done
      name="$(bar display -p -t "$TMUX_PANE" '#{window_name}')" || exit 0
      # A console whose last shell you ended is closed: its tab goes, and it doesn't
      # come back. (A crash takes the whole tmux with it, and it does come back.)
      if [[ "$name" == Shell\ <-> ]] && [ ! -f "$store/$name" ] &&
        env -u TMUX tmux list-sessions >/dev/null 2>&1; then
        rm -rf "$store/.tabs/$name"
        exit 0
      fi
      # Closing a project takes this tab away first (lib/project close). Still
      # here, the project stopped some other way: it comes back from its last
      # save the next time this tab is looked at.
    done
    ;;
  show)
    add "$2"
    bar select-window -t "=projects:=$2"
    # Stays the one shown when the bar opens around it (open-project).
    mkdir -p "$store"
    print -r -- "$2" >"$store/.active"
    ;;
  close)
    # The bar runs this from run-shell, which shows any output or a non-zero
    # exit in the pane (view mode: it swallows every key and click). So the
    # prompt is -b (returns at once, 0 whatever the answer) and the close
    # itself is quiet.
    name="$(bar display -p -t "$3" '#{window_name}')" || exit 0
    [ -n "$name" ] && [ "$name" != agvim ] || exit 0 # it has no x; always stays open
    if [ -f "$store/$name" ]; then
      question="Close ${name//\#/##}? Its tabs stop and come back when you open it. (y/n)"
    else
      question="Close ${name//\#/##} and all its tabs? (y/n)"
    fi
    # Only the window's id in the command: a name with a quote would break it.
    bar confirm-before -b -t "$2" -p "$question" \
      "run-shell -b \"~/.local/bin/agvim _projects close-now '$3' >/dev/null 2>&1 ; true\""
    ;;
  close-now)
    # Answered yes. A tmux session of yours with a name AgVim wouldn't give a project
    # (lib/project clean) isn't one of its projects: it just stops.
    name="$(bar display -p -t "$2" '#{window_name}')"
    [ -n "$name" ] && [ "$name" != agvim ] || exit 0
    if [ -f "$store/$name" ] || [ "$name" = "$("$repo/lib/project" clean-name "$name")" ]; then
      "$repo/lib/project" close "$name" "$2"
    else
      bar kill-window -t "$2"
      env -u TMUX "$repo/lib/tab" end "=$name" # and all that runs in it
    fi
    ;;
  stop)
    # The bar's client-detached hook runs this with no --now. With "keep terminals
    # running" on (the default), closing the window only saves: every project goes
    # on running, and the next agvim shows it again as it is.
    if [ "$2" != --now ]; then
      sleep 1 # a window that's only being replaced
      [ -z "$(bar list-clients 2>/dev/null)" ] || exit 0
      bar has-session -t '=projects' 2>/dev/null || exit 0
    fi
    "$repo/lib/project" save-all
    if [ "$2" != --now ] && [ ! -f ~/.config/agvim/keep-running-off ]; then
      exit 0
    fi
    # Stop only what is AgVim's: the bar's projects and their worktrees, and
    # consoles. Sessions you made yourself in tmux keep running. The bar goes first,
    # so its tabs don't start their projects again as they end.
    sessions=(${(f)"$(bar list-windows -t '=projects' -F '#{window_name}' 2>/dev/null)"})
    bar kill-server 2>/dev/null
    for s in ${(f)"$(work list-sessions -F '#{session_name}	#{@parent}' 2>/dev/null)"}; do
      name="${s%%$'\t'*}"
      parent="${s#*$'\t'}"
      if (( ${sessions[(Ie)$name]} )) || (( ${sessions[(Ie)$parent]} )) || [[ "$name" == Shell\ <-> ]]; then
        env -u TMUX "$repo/lib/tab" end "=$name"
      fi
    done
    [ -n "$(work list-sessions 2>/dev/null)" ] || work kill-server 2>/dev/null
    exit 0
    ;;
  popup)
    # From kitty's menu bar: agvim in a popup, over the window that has the bar.
    shift
    client="$(bar list-clients -F '#{client_name}' | head -1)"
    [ -n "$client" ] || exit 0
    bar display-popup -c "$client" -E -w 80% -h 70% "env -u TMUX AGVIM_POPUP=1 ~/.local/bin/agvim ${(q)@}"
    ;;
  front)
    [ -f ~/.config/agvim/last-terminal ] && open -a "$(<~/.config/agvim/last-terminal)"
    exit 0
    ;;
  new-terminal)
    mkdir -p ~/.config/agvim
    command=~/.config/agvim/open.command
    print -l '#!/bin/zsh -l' 'export PATH="$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin"' 'exec "$HOME/.local/bin/agvim" continue' >"$command"
    chmod +x "$command"
    "$repo/lib/terminal" "$command"
    ;;
  *)
    sed -n '2,17p' "${0:A}" | sed 's/^# \{0,1\}//'
    [ "$1" = -h ] || [ "$1" = --help ]
    ;;
esac
