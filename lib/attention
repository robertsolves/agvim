#!/bin/zsh
# attention: the dot on a tab whose agent is waiting for you or has finished, and on
# its project in the bar along the top. Showing that tab clears it.
#
#   attention set [waiting|done]   from an agent's hooks (Claude) or a bell (any
#                                  agent): marks the tab of $TMUX_PANE, unless it's the
#                                  one you're looking at; a notification too when
#                                  AgVim's window isn't in front
#   attention clear                the agent is working again (Claude's prompt hook)
#   attention session              Claude's session started: which conversation the
#                                  tab of $TMUX_PANE has, so it comes back as that one
#   attention bell <window id>     tmux's alert-bell hook
#   attention sync                 after you switch tabs or projects: clears what's
#                                  shown, and updates the bar's dots
#   attention watch [--restart]    while the bar is up: every agent's dot from what
#                                  its screen does (watch_tick), for agents without hooks
#
# Used as `agvim _attention`, from tmux.conf, projects.conf and lib/claude-settings.json.
# Prints nothing and always exits 0: tmux hooks and agents run it.
exec >/dev/null 2>&1
unset TMUX
here="${0:A:h}" # a function's own $0 is its name, so this is set out here
bar() { command tmux -L projects "$@"; }
zmodload zsh/datetime

# A tab's state, and when it was set: watch_tick only takes output after that as work.
put() { # window, state
  tmux set-option -w -t "$1" @agent-state "$2"
  tmux set-option -w -t "$1" @agent-at "$EPOCHSECONDS"
}

# Claude's hooks get JSON with the conversation's session_id on stdin. lib/project
# saves it with the tab, and resumes that conversation, not just the folder's last.
remember_session() {
  [ -n "$TMUX_PANE" ] && [ ! -t 0 ] || return 0
  local id="$(tr ',{}' '\n\n\n' | sed -n 's/^ *"session_id" *: *"\([A-Za-z0-9-]*\)".*/\1/p' | head -1)"
  [ -n "$id" ] && tmux set-option -p -t "$TMUX_PANE" @agent-session "$id"
}

# The window you're looking at in the project tmux, if a window shows the bar.
visible() {
  local tty
  tty="$(bar display -p -t '=projects:' '#{pane_tty}')" || return 1
  [ -n "$(bar list-clients)" ] || return 1
  tmux list-clients -F '#{client_tty}	#{window_id}' | awk -F'\t' -v t="$tty" '$1 == t { print $2 }'
}

# Is a window showing the bar in front (tmux focus events)?
focused() {
  bar list-clients -F '#{client_flags}' | grep -q focused
}

# Dots on the bar: a project has one when any of its tabs (or its worktrees') has.
# The worktree row shows them per worktree (lib/worktree render).
sync_bar() {
  bar has-session -t '=projects' || return 0
  local f
  for f in "${here:h}"/saved-projects/.worktrees/*(N.); do
    "$here/worktree" render "${f:t}"
  done
  # Each project's busiest state: waiting, then working, then done.
  local busiest
  busiest="$(tmux list-windows -a -F '#{session_name}	#{@parent}	#{@agent-state}' | awk -F'\t' '
    $3 != "" { p = ($2 != "" ? $2 : $1); r = ($3 == "waiting" ? 3 : ($3 == "working" ? 2 : 1))
               if (r > best[p]) { best[p] = r; st[p] = $3 } }
    END { for (p in st) print p "\t" st[p] }')"
  local win name state new
  bar list-windows -t '=projects' -F '#{window_id}	#{window_name}	#{@agent-state}' | while IFS=$'\t' read -r win name state; do
    new="$(print -r -- "$busiest" | awk -F'\t' -v n="$name" '$1 == n { print $2 }')"
    [ "$new" = "$state" ] && continue
    if [ -n "$new" ]; then bar set-option -w -t "$win" @agent-state "$new"; else bar set-option -wu -t "$win" @agent-state; fi
  done
}

# What runs in the foreground of terminal $1: agent (a program named in agents.tsv,
# also under node or python), ui (one that waits for you, like Neovim), busy
# (anything else: a build, tests, a server), or nothing at its shell. Shells and
# their "zsh -c" wrappers don't count. "new" for a terminal under five seconds old:
# what runs while a shell starts (its .zshrc) isn't work. One terminal's `ps -t` is
# cheap; all of them at once (ps -ax) costs a tenth of a second of CPU.
fg_kind() {
  ps -t "${1#/dev/}" -o stat=,etime=,args= 2>/dev/null | awk -v names=" ${agents[*]} " -v uis=" nvim vim vi lazygit less more man htop top btop tig fzf " '
    # etime is [[dd-]hh:]mm:ss; the session leader is the terminal'"'"'s first process.
    $1 ~ /s/ { e = $2; d = 0; if (index(e, "-")) { d = substr(e, 1, index(e, "-") - 1); e = substr(e, index(e, "-") + 1) }
               c = split(e, t, ":")
               if (c == 3) age = d * 86400 + t[1] * 3600 + t[2] * 60 + t[3]; else age = d * 86400 + t[1] * 60 + t[2]
               if (age < 5) young = 1 }
    $1 ~ /\+/ {
      n = $3; sub(/.*\//, "", n); sub(/^-/, "", n)
      # A shell running a script is that script (an agent launched by one), not "zsh -c".
      if (n ~ /^(zsh|bash|fish|sh|dash|ksh)$/) { if (NF < 4 || $4 ~ /^-/) next; m = $4; sub(/.*\//, "", m); if (!index(names, " " m " ")) next; n = m }
      if (n ~ /^(node|bun|deno|python[0-9.]*)$/ && NF >= 4) { m = $4; sub(/.*\//, "", m); sub(/\.js$/, "", m); if (index(names, " " m " ")) n = m }
      r = index(names, " " n " ") ? 3 : (index(uis, " " n " ") ? 2 : 1)
      if (r > k) k = r
    }
    END { if (young) print "new"; else print (k == 3 ? "agent" : (k == 2 ? "ui" : (k == 1 ? "busy" : ""))) }'
}

# Every tab's dot, every second, without anyone's help:
#   - an agent whose screen keeps changing (its spinner, its output) for two seconds
#     is working; one that stopped after working is done
#   - any other program running at a shell (a build, tests) is working from its
#     first second; when it ends, the tab is done
#   - back at the shell after an agent, it has nothing
# Done is blue until you look at the tab, unless you were looking already. Claude's
# hooks say more (waiting) and are kept. Neovim's tabs are left to the hooks: an
# agent in Neovim runs on a terminal of its own.
typeset -A busy_since
typeset -A kind_of sig_of looked_at
watch_tick() {
  local now="$EPOCHSECONDS" changed="" win state at tty act was cmd kind shown line f
  # Few processes a second: the window shown in a focused window of the bar, and
  # every tab with its clients, each in one tmux call.
  local bar_rows rows
  local -A seen
  bar_rows=("${(@f)$(bar display -p -t '=projects:' '#{pane_tty}' \; list-clients -F '#{client_flags}' 2>/dev/null)}")
  flags="${(j: :)bar_rows[2,-1]}" # also for the loop in watch: how often to look
  # "-" for no value: read joins empty fields between tabs.
  rows="$(tmux list-clients -F 'C	#{client_tty}	#{window_id}' \; list-windows -a -F 'W	#{window_id}	#{?#{@agent-state},#{@agent-state},-}	#{?#{@agent-at},#{@agent-at},0}	#{?#{@agent-kind},#{@agent-kind},-}	#{pane_tty}	#{window_activity}	#{pane_current_command}' 2>/dev/null)"
  shown=""
  if [[ "$flags" == *focused* ]]; then
    for line in ${(f)rows}; do
      [[ "$line" == "C	$bar_rows[1]	"* ]] && { shown="${line##*	}"; break; }
    done
  fi
  for line in ${(f)rows}; do
    [[ "$line" == W* ]] || continue
    f=("${(@ps:\t:)line}") # (not read <<<: zsh writes a file for each)
    win="$f[2]" state="$f[3]" at="$f[4]" was="$f[5]" tty="$f[6]" act="$f[7]" cmd="$f[8]"
    seen[$tty]=1
    # What runs there is looked up again when the program in front changes, and
    # every ten seconds anyway (an agent behind a "zsh -c" wrapper).
    if [ "$sig_of[$tty]" != "$cmd" ] || (( now - ${looked_at[$tty]:-0} >= 10 )); then
      kind_of[$tty]="$(fg_kind "$tty")"
      sig_of[$tty]="$cmd"
      looked_at[$tty]="$now"
    fi
    kind="$kind_of[$tty]"
    [ "$state" != - ] || state=""
    case "$kind" in
      ui) unset "busy_since[$win]"; continue ;;
      new) unset "busy_since[$win]"; looked_at[$tty]=0; continue ;; # look again next second
      "")
        unset "busy_since[$win]"
        [ -n "$state" ] || continue
        if [ "$was" = busy ] && [ "$state" = working ] && [ "$win" != "$shown" ]; then
          put "$win" done
        elif [ "$was" = busy ] && [ "$state" = done ] && [ "$win" != "$shown" ]; then
          continue
        else
          tmux set-option -wu -t "$win" @agent-state
          tmux set-option -wu -t "$win" @attention
        fi
        changed=1
        continue
        ;;
      busy)
        [ -n "$busy_since[$win]" ] || busy_since[$win]="$now"
        (( now - busy_since[$win] >= 1 )) && [ "$state" != working ] || continue
        put "$win" working
        tmux set-option -w -t "$win" @agent-kind busy
        changed=1
        continue
        ;;
    esac
    # An agent.
    if [ "$was" != agent ]; then
      # Just started: what it draws first isn't work.
      tmux set-option -w -t "$win" @agent-kind agent
      tmux set-option -w -t "$win" @agent-at "$now"
      at="$now"
    fi
    if (( now - act <= 2 )); then
      (( act > at + 2 )) || continue # the redraw that came with being marked
      [ -n "$busy_since[$win]" ] || busy_since[$win]="$now"
      (( now - busy_since[$win] >= 2 )) && [ "$state" != working ] || continue
      put "$win" working
      changed=1
    else
      unset "busy_since[$win]"
      [ "$state" = working ] || continue
      if [ "$win" = "$shown" ]; then tmux set-option -wu -t "$win" @agent-state; else put "$win" done; fi
      changed=1
    fi
  done
  # Terminals that have gone: a new tab can get the same one.
  local t
  for t in "${(@k)kind_of}"; do
    [ -n "$seen[$t]" ] || unset "kind_of[$t]" "sig_of[$t]" "looked_at[$t]"
  done
  [ -n "$changed" ] || return 0
  sync_bar
  local c
  for c in ${(f)"$(tmux list-clients -F '#{client_name}')"}; do tmux refresh-client -S -t "$c"; done
  for c in ${(f)"$(bar list-clients -F '#{client_name}')"}; do bar refresh-client -S -t "$c"; done
}

notify() {
  command -v osascript >/dev/null || return 0
  focused && return 0
  local where
  where="$(tmux display -p -t "$1" '#{session_name} · #{window_name}')"
  osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' \
    "AgVim" "$2 in $where" &!
}

mark() { # window, state
  local win="$1" state="${2:-done}" shown
  shown="$(visible)"
  if [ "$win" = "$shown" ] && focused; then
    sync_bar
    return 0 # you're looking at it: no alert, the dot still follows
  fi
  put "$win" "$state" # stays after you look (lib/running)
  tmux set-option -w -t "$win" @attention "$state"
  sync_bar
  if [ "$state" = waiting ]; then notify "$win" "An agent needs you"; else notify "$win" "An agent finished"; fi
}

case "$1" in
  set)
    [ -n "$TMUX_PANE" ] || exit 0
    win="$(tmux display -p -t "$TMUX_PANE" '#{window_id}')"
    put "$win" "${2:-done}"
    mark "$win" "$2"
    ;;
  session)
    remember_session
    ;;
  clear)
    [ -n "$TMUX_PANE" ] || exit 0
    remember_session # also for one that started before AgVim kept these
    put "$TMUX_PANE" working
    tmux set-option -wu -t "$TMUX_PANE" @attention
    sync_bar
    ;;
  bell)
    # Claude's hooks say more than a bell does; don't let its bell undo "waiting".
    [ -n "$(tmux show-options -wqv -t "$2" @attention)" ] && exit 0
    # A shell's bell (a completion that found nothing) isn't an agent.
    # (pane_current_command can't tell: an agent tab runs "zsh -c <agent>".)
    agents=(${(f)"$(grep -v '^#' "$here/agents.tsv" | cut -f2)"})
    tty="$(tmux display -p -t "$2" '#{pane_tty}')"
    [ "$(fg_kind "$tty")" = agent ] || exit 0
    mark "$2" done
    ;;
  sync)
    shown="$(visible)"
    [ -z "$shown" ] || tmux set-option -wu -t "$shown" @attention
    # A command that ended is done until you look at its tab (watch_tick).
    if [ -n "$shown" ] && [ "$(tmux show-options -wqv -t "$shown" @agent-kind)" = busy ] &&
      [ "$(tmux show-options -wqv -t "$shown" @agent-state)" = done ]; then
      tmux set-option -wu -t "$shown" @agent-state
    fi
    # The agent tab you looked at last is where agvim send sends (lib/send).
    for line in ${(f)"$(tmux list-sessions -F '#{session_id}	#{window_id}	#{@agent}	#{pane_current_command}')"}; do
      parts=("${(@s:	:)line}")
      if [ -n "$parts[3]" ] || [[ "$parts[4]" != (-|)(zsh|bash|fish|sh|nvim|lazygit) ]]; then
        tmux set-option -t "$parts[1]" @last-agent "$parts[2]"
      fi
    done
    sync_bar
    ;;
  watch)
    # One at a time, for as long as the bar is up (lib/projects and agvim refresh
    # start it).
    # --restart (agvim refresh): a new one, so changes to this file show.
    pid="$(bar show -gqv @watch)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      [ "$2" = --restart ] || exit 0
      kill "$pid"
    fi
    bar set -g @watch "$$"
    agents=(${(f)"$(grep -v '^#' "$here/agents.tsv" | cut -f2)"})
    # Every second while a window shows the bar; every five when none does.
    while bar has-session -t '=projects' 2>/dev/null; do
      watch_tick
      if [ -n "$flags" ]; then sleep 1; else sleep 5; fi
    done
    ;;
esac
exit 0
