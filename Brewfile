# What install.sh installs with `brew bundle`. kitty and the Nerd Font casks are
# installed separately, only when missing.
brew "neovim"
brew "tmux"
brew "git"
brew "ripgrep"
brew "fd"
brew "fzf"
brew "lazygit"
brew "tree-sitter-cli"
brew "node"           # Mason's JS-based language servers, prettierd, js-debug
brew "imagemagick"    # images in Neovim (JPG, GIF, WebP)
brew "librsvg"        # rsvg-convert: SVG rendered in a float
brew "xcode-build-server" # Swift / Objective-C in a Flutter app's ios/ folder
