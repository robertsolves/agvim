#!/bin/zsh
# AgentNV.app's first launch on a Mac: a copy of the app's files in ~/.agentnv, then
# install.sh, which installs the basics. Then it opens AgentNV in kitty.

export PATH="$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin"
payload="${0:A:h:h:h}"
dir="${AGENTNV_DIR:-$HOME/.agentnv}"
url="${AGENTNV_URL:-https://github.com/robertsolves/agentnv.git}"

stop() {
  print -r -- ""
  print -r -- "AgentNV isn't set up: $1"
  print -r -- "Press Enter to close. Opening AgentNV again tries again."
  read -r _
  exit 1
}

"$payload/lib/banner"
print -r -- "Setting up AgentNV, once. It installs Homebrew if it's missing (your Mac asks for your"
print -r -- "password), then kitty, git, Neovim, tmux, lazygit and the other basics."
print -r -- ""

if [ ! -f "$dir/install.sh" ]; then
  ditto "$payload" "$dir" || stop "couldn't copy its files to $dir."
  xattr -dr com.apple.quarantine "$dir" 2>/dev/null
fi

AGENTNV_NO_LAUNCH=1 "$dir/install.sh" ${=AGENTNV_INSTALL_ARGS} || stop "install.sh failed. See above."

# Git is here for sure now. A clone, so agentnv update works, if GitHub can be reached.
if [ ! -d "$dir/.git" ]; then
  git -C "$dir" init -q -b main
  git -C "$dir" remote add origin "$url"
  if git -C "$dir" fetch -q --depth 1 origin main 2>/dev/null; then
    git -C "$dir" reset -q --hard origin/main
    git -C "$dir" branch -q -u origin/main 2>/dev/null
  else
    print -r -- "Couldn't reach GitHub: using the version in this app. agentnv update won't work until it can."
  fi
fi

print -r -- ""
print -r -- "Done. Opening AgentNV."
# In kitty already: right here. Otherwise in kitty, which is here now.
[ -n "$KITTY_WINDOW_ID" ] && exec ~/.local/bin/agentnv continue
~/.local/bin/agentnv _projects new-terminal
print -r -- "You can close this window."
