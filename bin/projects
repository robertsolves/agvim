#!/bin/zsh
# projects: the projects bar, the tabs along the top (tmux/projects.conf). Each
# of its tabs shows one project's tmux session.
#
#   projects                       show the bar here (kitty runs this on start):
#                                  restores the projects after a restart, opens
#                                  this repo as one too (so you can change the
#                                  setup as you go), reloads both tmux configs,
#                                  gives each project a tab; none open: pick one
#   projects show <name>           give project <name> a tab and show it
#   projects close <client> <id>   ask, then close that tab's project and all its tabs
#
# Used by open-project, kitty/startup-session.conf and the bar's x.

repo="${0:A:h:h}"
conf="$repo/tmux/projects.conf"
bar() { command tmux -L projects "$@"; }
work() { env -u TMUX tmux "$@"; } # your tmux, where the projects run

# A tab for project $1 (attached to its session) unless it has one.
add() {
  bar list-windows -t '=projects' -F '#{window_name}' 2>/dev/null | grep -qxF -- "$1" && return
  local cmd=(env -u TMUX "$(command -v tmux)" attach -t "=$1")
  if bar has-session -t '=projects' 2>/dev/null; then
    bar new-window -d -t '=projects:' -n "$1" "${cmd[@]}"
  else
    bar -f "$conf" new-session -d -s projects -n "$1" -x 200 -y 50 "${cmd[@]}"
  fi
}

# After a restart your tmux isn't running: start it, which makes tmux-continuum
# restore the saved projects, and wait until no more of them appear.
restore() {
  work has-session 2>/dev/null && return
  work new-session -d -s _start
  local count=1 same=0 n
  for _ in {1..40}; do
    sleep 0.5
    n="$(work list-sessions 2>/dev/null | wc -l)"
    if [ "$n" -gt 1 ] && [ "$n" = "$count" ]; then
      same=$((same + 1))
      [ "$same" -ge 4 ] && break
    else
      same=0
    fi
    count="$n"
  done
  work kill-session -t '=_start' 2>/dev/null
}

case "$1" in
  "")
    if work has-session 2>/dev/null; then
      work source-file ~/.tmux.conf # pick up changes to it
    else
      restore
    fi
    AW_NO_ATTACH=1 ~/.local/bin/open-project "$repo"
    bar source-file "$conf" 2>/dev/null
    while true; do
      for s in ${(f)"$(work list-sessions -F '#{session_name}' 2>/dev/null)"}; do
        add "$s"
      done
      if ! bar has-session -t '=projects' 2>/dev/null; then
        # No projects: pick one (Esc for a plain shell).
        AW_NO_ATTACH=1 ~/.local/bin/p
        work has-session 2>/dev/null || exec /bin/zsh -l
        continue
      fi
      # Returns when the last project closes; then it's back to the picker.
      env -u TMUX tmux -L projects attach -t '=projects'
      bar has-session -t '=projects' 2>/dev/null && exit 0 # closed the window
    done
    ;;
  show)
    add "$2"
    bar select-window -t "=projects:=$2"
    ;;
  close)
    # The bar runs this from run-shell, which shows any output or a non-zero
    # exit in the pane (view mode: it swallows every key and click). So the
    # prompt is -b (returns at once, 0 whatever the answer) and the close
    # itself is quiet.
    name="$(bar display -p -t "$3" '#{window_name}')" || exit 0
    # Your tmux's socket, so tmux-resurrect saves that one, not the bar.
    sock="$(work display -p '#{socket_path}')"
    bar confirm-before -b -t "$2" -p "Close ${name//\#/##} and all its tabs? (y/n)" \
      "run-shell -b \"{ env -u TMUX tmux kill-session -t '=$name' ; TMUX='$sock,0,0' ~/.tmux/plugins/tmux-resurrect/scripts/save.sh ; } >/dev/null 2>&1 ; true\""
    ;;
  *)
    sed -n '2,13p' "${0:A}" | sed 's/^# \{0,1\}//'
    [ "$1" = -h ] || [ "$1" = --help ]
    ;;
esac
