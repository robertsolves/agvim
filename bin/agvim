#!/bin/zsh
# agvim: the one command, from any terminal. On its own it asks what you want.
#
# Projects (-p picks one; otherwise the one you're in)
#   agvim add [folder] [-p name]     add a folder (default: here) to a project, made
#                                      if needed. Outside any project: a new one
#   agvim new [folder] [-n name]     save a folder as a new project and open it
#   agvim open [folder] [-p name]    open a folder or a project; neither: pick one
#   agvim close [-p name]            save a project and stop its tabs
#   agvim remove [folder] [-p name]  take a folder out of a project
#   agvim rename [new] [-p name]     rename a project; asks what it doesn't know
#   agvim delete [-p name]           forget a project and close it (its folders stay);
#                                      asks which, and to be sure, without -p
#   agvim list                       your projects, their folders, which are running
#   add and new take --no-open: save it without opening anything.
#
# Tabs
#   agvim tab [command] [-p name]    a new tab: a shell, or a command such as claude
#   agvim tabs [-p name]             the tabs of a project
#   agvim agent <name> [-p name]     a new tab with a coding agent
#   agvim agents [--running]         the agents it knows, and where to get them;
#                                      --running: every agent tab, to jump to one
#   agvim send [-t tab] [text]       put text (or what's piped in) in an agent's prompt
#   agvim name <text>                rename the tab you're in; agents won't change it
#   agvim shell                      a terminal of its own, outside any project
#
# Agents
#   agvim worktree [name]            a branch in a folder of its own, with its tabs
#                                      in the row under the projects (alias: branch)
#   agvim worktree list|close [name] its worktrees; close one (asks if work would go)
#   agvim merge                      merge the worktree you're in: merge, squash or PR
#   agvim init [folder] [--agent]    an AGENTS.md (and CLAUDE.md, GEMINI.md) for a project
#   agvim skills                     add skills and slash commands from a library, for
#                                      every agent: pick one or several. Also add,
#                                      remove, list, update, source add|remove|list
#
# The workspace
#   agvim continue                   what was open last time
#   agvim refresh                    load changes to AgVim, keeping everything open
#   agvim save                       save everything now (it's automatic too)
#   agvim stop                       save everything, stop it all, close the window
#   agvim keep-running [on|off]      closing the window leaves everything running (on
#                                      by default); off stops it all, like agvim stop
#   agvim diff [rev]                 every git change here, side by side
#   agvim ai [source|off|list]       AI suggestions as you type: free Copilot, or your key
#                                      for Claude, OpenAI, Gemini, DeepSeek and many more
#   agvim ai test [source]           check that a source really answers
#   agvim ai signin                  sign in to Copilot
#   agvim folder                     show where your projects are saved
#   agvim roots [add|remove folder]  where the project picker looks for folders
#   agvim terminal [app|auto]        which terminal the icon and Finder use
#   agvim update                     the latest version and tools, installed again
#   agvim autoupdate [on|off]        update to new releases when it opens (on by default)
#   agvim release <version>          publish a new version (from a clone, for maintainers)
#   agvim uninstall [--brew]         remove it all, after asking
#   agvim version
#   agvim help
#
# The scripts behind it are in lib/. tmux, Neovim and Finder call them as
# `agvim _<script>`, so only this command needs to be on your PATH.

export PATH="$PATH:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin"
self="${0:A}"
repo="${0:A:h:h}"
lib="$repo/lib"
store="$repo/saved-projects"
tab=$'\t'

help() { "$lib/banner"; sed -n '2,/^# The scripts behind/p' "$self" | sed '$d' | sed 's/^# \{0,1\}//'; }

die() {
  print -r -- "agvim: $1" >&2
  exit 1
}

# Options anywhere among the arguments; what's left is in $args.
args=()
project=""
name=""
no_open=""
ai_url=""
ai_model=""
no_check=""
parse() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -p | --project) [ -n "$2" ] || die "$1 needs a project name"; project="$2"; shift 2 ;;
      -n | --name) [ -n "$2" ] || die "$1 needs a name"; name="$2"; shift 2 ;;
      --no-open) no_open=1; shift ;;
      --no-check) no_check=1; shift ;;
      --url) [ -n "$2" ] || die "$1 needs a URL"; ai_url="$2"; shift 2 ;;
      --model) [ -n "$2" ] || die "$1 needs a model"; ai_model="$2"; shift 2 ;;
      -h | --help) help; exit 0 ;;
      --) shift; args+=("$@"); return ;;
      -*) die "no option called $1 here. See agvim help" ;;
      *) args+=("$1"); shift ;;
    esac
  done
}

# The project this shell is in, if it's in one (a console isn't). In a popup from
# kitty's menu bar, the one showing.
current() {
  [ -n "$(tmux -L projects list-clients 2>/dev/null)" ] || return 1
  local s
  if [ -n "$AGVIM_POPUP" ]; then
    s="$(tmux -L projects display -p -t '=projects:' '#{window_name}' 2>/dev/null)"
  else
    [ -n "$TMUX" ] || return 1
    s="$(tmux display -p '#{session_name}' 2>/dev/null)" || return 1
  fi
  [ -n "$s" ] || return 1
  [[ "$s" == Shell\ <-> && ! -f "$store/$s" ]] && return 1
  print -r -- "$s"
}

# -p, else the project you're in, else stop.
which_project() {
  [ -n "$project" ] && { print -r -- "$project"; return; }
  current || die "not in a project: say which with -p <name>"
}

# The same, but a + Shell console counts too: it has tabs, just no saved folders.
which_session() {
  [ -n "$project" ] && { print -r -- "$project"; return; }
  current && return
  if [ -n "$TMUX" ] && [ -z "$AGVIM_POPUP" ]; then
    local s
    s="$(tmux display -p '#{session_name}' 2>/dev/null)"
    [[ "$s" == Shell\ <-> ]] && { print -r -- "$s"; return; }
  fi
  die "not in a project: say which with -p <name>"
}

# AI autocomplete: settings are NAME=value lines in a file only you can read.
ai_file=~/.config/agvim/ai
ai_get() { [ -f "$ai_file" ] && sed -n "s/^$1=//p" "$ai_file" | tail -1; }
ai_set() {
  (
    umask 077
    mkdir -p "${ai_file:h}"
    touch "$ai_file"
    { grep -v "^$1=" "$ai_file"; print -r -- "$1=$2"; } >"$ai_file.tmp"
    mv "$ai_file.tmp" "$ai_file"
    chmod 600 "$ai_file"
  )
}
ai_row() { awk -F'\t' -v id="$1" '$1 == id' "$lib/ai-providers.tsv"; }
ai_name() {
  local use="$(ai_get use)"
  use="${use:-copilot}"
  if [ "$use" = off ]; then print -r -- "off"; return; fi
  ai_row "$use" | cut -f2 | sed 's/ (.*//'
}

# Copilot's sign-in, in this terminal (lib/copilot-signin.lua).
ai_signin() {
  ai_set use copilot
  nvim --headless -c "luafile $lib/copilot-signin.lua"
}

# Asks the service for its models, to choose from. Empty if it won't say.
ai_models() {
  local url="$1" key="$2"
  printf 'header = "Authorization: Bearer %s"\n' "$key" |
    curl -sS -m 15 -K - "${url%/chat/completions}/models" 2>/dev/null |
    grep -oE '"id"[[:space:]]*:[[:space:]]*"[^"]+"' | sed -E 's/.*"([^"]+)"$/\1/' | sort -u
}

# Chooses source $1, asking for what it needs, then checks it really works. Keys never
# reach the screen or a command line.
ai_use() {
  local id="$1" row kind url model key answer listed rc
  row="$(ai_row "$id")"
  [ -n "$row" ] || die "no AI source called $id. See agvim ai list"
  kind="$(print -r -- "$row" | cut -f3)"
  url="$(print -r -- "$row" | cut -f4)"
  model="$(print -r -- "$row" | cut -f5)"
  if [ "$kind" = copilot ]; then
    ai_set use copilot
    if [ -t 0 ]; then
      ai_signin || print -r -- "Choose this again to retry."
    fi
    print -r -- "AI autocomplete now uses $(ai_name)."
    return
  fi
  if [ "$url" = ask ]; then
    [ -n "$ai_url" ] || ai_url="$(ai_get "url_$id")"
    if [ -t 0 ]; then
      print -rn -- "Its chat/completions URL [$ai_url]: "
      read -r answer
      ai_url="${answer:-$ai_url}"
    fi
    [ -n "$ai_url" ] || die "it needs a URL: --url <its chat/completions URL>"
    ai_set "url_$id" "$ai_url"
  fi
  if [ -t 0 ]; then
    print -rn -- "API key (hidden; Enter keeps the saved one, or none if it needs none): "
    read -rs key
    print -r -- ""
  else
    IFS= read -r key
  fi
  [ -z "$key" ] || ai_set "key_$id" "$key"
  key="$(ai_get "key_$id")"
  if [ "$kind" = compatible ]; then
    [ -n "$ai_model" ] || ai_model="$(ai_get "model_$id")"
    [ -n "$ai_model" ] || { [ "$model" = ask ] || ai_model="$model"; }
    if [ -t 0 ]; then
      listed="$(ai_models "$(ai_get "url_$id" | grep . || print -r -- "$url")" "$key")"
      if [ -n "$listed" ]; then
        answer="$(print -r -- "$listed" | fzf --height=~20 --reverse --no-info --query="$ai_model" --prompt="model> ")" || exit 0
        ai_model="$answer"
      else
        print -rn -- "Model [$ai_model]: "
        read -r answer
        ai_model="${answer:-$ai_model}"
      fi
    fi
    [ -n "$ai_model" ] || die "it needs a model: --model <name>"
    ai_set "model_$id" "$ai_model"
  elif [ -n "$ai_model" ]; then
    ai_set "model_$id" "$ai_model"
  fi
  rc=0
  if [ -z "$no_check" ]; then
    "$lib/ai-test" "$id"
    rc=$?
  fi
  # A refused key isn't worth switching to; anything else may just be temporary.
  if [ "$rc" = 2 ]; then
    print -r -- "AI autocomplete stays on $(ai_name). Choose this again with another key."
    return 1
  fi
  ai_set use "$id"
  print -r -- "AI autocomplete now uses $(ai_name)."
}

# So open Neovims pick up a new source straight away.
ai_apply() {
  [ -z "$(tmux list-sessions 2>/dev/null)" ] || "$lib/project" refresh
}

# Asks which saved project (agvim itself can't be renamed or deleted).
pick_project() {
  [ -t 0 ] || die "say which project with -p <name>"
  local names
  names="$("$lib/project" names)"
  [ -n "$names" ] || die "no projects yet"
  print -r -- "$names" | fzf --height=~15 --reverse --no-info --prompt="$1> "
}

folder_arg() {
  local folder="${1:-.}"
  [ -e "$folder" ] || die "no such folder: $folder"
  print -r -- "$folder"
}

keep_off=~/.config/agvim/keep-running-off
keep_state() { [ -f "$keep_off" ] && print -r -- off || print -r -- on; }

# The menu. $1 is the row to start on (after a toggle, the same one again).
wizard() {
  local rows=() open=""
  if [ -n "$AGVIM_POPUP" ]; then
    : # it's what you're looking at
  elif [ -z "$TMUX" ] && [ -n "$(tmux -L projects list-clients 2>/dev/null)" ]; then
    rows+=("continue${tab}Show what's open")
  elif tmux -L projects has-session -t '=projects' 2>/dev/null; then
    # Closed with keep terminals running on: it's all still there.
    local running=(${(f)"$(tmux -L projects list-windows -t '=projects' -F '#{window_name}' 2>/dev/null | grep -vx agvim)"})
    rows+=("continue${tab}Back to what's running${running:+ (${(j:, :)running})}")
  else
    # Only what still exists; the agvim tab alone isn't somewhere you left off.
    local name left=()
    if [ -s "$store/.open" ]; then
      for name in ${(f)"$(<"$store/.open")"}; do
        [ "$name" != agvim ] || continue
        if [ -f "$store/$name" ] || [ -s "$store/.tabs/$name/tabs" ]; then
          left+=("$name")
        fi
      done
    fi
    [ "${#left}" -eq 0 ] || rows+=("continue${tab}Continue where you left off (${(j:, :)left})")
  fi
  rows+=(
    "open${tab}Open project"
    "keep${tab}Keep terminals running after closing  [$(keep_state)]"
    "ai${tab}AI autocomplete ($(ai_name))"
    "rename${tab}Rename a project"
    "delete${tab}Delete a project"
    "folder${tab}Open projects folder"
    "refresh${tab}Refresh (load changes, keep everything open)"
    "update${tab}Update"
    "uninstall${tab}Uninstall"
    "exit${tab}Exit"
  )
  local pick start=()
  [ -z "$1" ] || start=(--bind "start:pos($1)")
  pick="$(print -rl -- "${rows[@]}" | fzf --delimiter="$tab" --with-nth=2 --height=~15 --reverse --no-info --prompt="agvim> " "${start[@]}")" || return 0
  # The row's number too, to come back to it.
  print -r -- "${pick%%$tab*}${tab}${rows[(ie)$pick]}"
}

cmd="$1"
[ $# -gt 0 ] && shift
# Opening AgVim: get the newest release first, then start again as that version. Not when
# it's open already, as it would only change under you.
case "$cmd" in
  "" | continue | open)
    # Not while projects are still running from last time either (keep terminals running).
    if [ -z "$AGVIM_UPDATED$AGVIM_POPUP" ] && ! tmux -L projects has-session -t '=projects' 2>/dev/null && "$lib/auto-update"; then
      AGVIM_UPDATED=1 exec "$self" "$cmd" "$@"
    fi
    ;;
esac
if [ -z "$cmd" ]; then
  [ -t 0 ] || { help; exit 0; } # nobody there to ask
  "$lib/banner"
  # Back to the menu after anything that doesn't lead into the workspace. Esc leaves.
  row=""
  while true; do
    cmd="$(wizard "$row")"
    row="${cmd#*$tab}"
    cmd="${cmd%%$tab*}"
    [ -n "$cmd" ] && [ "$cmd" != exit ] || exit 0
    if [ "$cmd" = keep ]; then
      # Flips it and shows the menu again on the same row, so it reads as a switch.
      if [ -f "$keep_off" ]; then rm -f "$keep_off"; else mkdir -p "${keep_off:h}"; touch "$keep_off"; fi
      continue
    fi
    row=""
    case "$cmd" in
      ai | rename | delete | folder | refresh | update) "$self" "$cmd" ;;
      open)
        "$lib/p"
        rc=$?
        [ "$rc" = 3 ] || exit "$rc" # 3: left the picker without choosing
        ;;
      *) break ;;
    esac
  done
fi

case "$cmd" in
  continue) exec "$lib/projects" ;;
  add)
    parse "$@"
    folder="$(folder_arg "$args[1]")" || exit 1
    [ -n "$no_open" ] && export AW_NO_OPEN=1
    [ -n "$project" ] || project="$(current)"
    [ -n "$project" ] || exec "$lib/project" new "$folder"
    exec "$lib/project" add "$project" "$folder"
    ;;
  new)
    parse "$@"
    folder="$(folder_arg "$args[1]")" || exit 1
    [ -n "$no_open" ] && export AW_NO_OPEN=1
    exec "$lib/project" new "$folder" "${name:-$args[2]}"
    ;;
  open)
    parse "$@"
    [ -z "$project" ] || exec "$lib/open-project" --project "$project"
    if [ -z "$args[1]" ]; then
      "$lib/p"
      rc=$?
      [ "$rc" = 3 ] && exit 0
      exit "$rc"
    fi
    folder="$(folder_arg "$args[1]")" || exit 1
    exec "$lib/open-project" "$folder"
    ;;
  close)
    parse "$@"
    target="$(which_project)" || exit 1
    exec "$lib/project" close-tab "$target"
    ;;
  remove)
    parse "$@"
    folder="${args[1]:-.}" # it may have been moved or deleted: that's why it's being removed
    target="$(which_project)" || exit 1
    exec "$lib/project" remove "$target" "$folder"
    ;;
  rename)
    parse "$@"
    if [ -n "$project" ]; then
      target="$project"
    else
      # The project you're in, else ask which.
      target="$(current)" || target="$(pick_project "rename")" || exit 0
    fi
    new_name="$args[1]"
    if [ -z "$new_name" ]; then
      print -rn -- "New name for $target: "
      read -r new_name
      [ -n "$new_name" ] || exit 0
    fi
    exec "$lib/project" rename "$target" "$new_name"
    ;;
  delete)
    parse "$@"
    [ -n "$project" ] || project="$args[1]"
    if [ -z "$project" ]; then
      project="$(pick_project "delete")" || exit 0
      print -rn -- "Delete $project? Its tabs close; its folders stay. (y/N) "
      read -r answer
      [[ "$answer" == [yY]* ]] || exit 0
    fi
    exec "$lib/project" delete "$project"
    ;;
  list) exec "$lib/project" list ;;
  shell) exec "$lib/project" shell ;;
  tab)
    parse "$@"
    target="$(which_session)" || exit 1
    exec "$lib/project" tab "$target" "${args[@]}"
    ;;
  agent)
    parse "$@"
    [ -n "$args[1]" ] || die "usage: agvim agent <name> [-p name]. See agvim agents"
    where="$(awk -F'\t' -v n="$args[1]" '$2 == n { print $4 }' "$lib/agents.tsv")"
    [ -n "$where" ] || die "no agent called $args[1]. See agvim agents"
    command -v "$args[1]" >/dev/null || die "$args[1] isn't installed. Get it from $where"
    target="$(which_session)" || exit 1
    exec "$lib/project" tab "$target" "$args[1]"
    ;;
  agents)
    [ "$1" = --running ] && { shift; exec "$lib/running" "$@"; }
    grep -v '^#' "$lib/agents.tsv" | while IFS=$'\t' read -r key agent again where flags; do
      if command -v "$agent" >/dev/null; then state=ready; else state=missing; fi
      printf 'Space t%s  %-13s %-8s %s\n' "$key" "$agent" "$state" "$where"
    done
    ;;
  tabs)
    parse "$@"
    target="$(which_session)" || exit 1
    exec "$lib/project" tabs "$target"
    ;;
  send) exec "$lib/send" "$@" ;;
  worktree | branch)
    case "$1" in
      new | list | merge | close) exec "$lib/worktree" "$@" ;;
      *) exec "$lib/worktree" new "$@" ;;
    esac
    ;;
  worktrees) exec "$lib/worktree" list "$@" ;;
  merge) exec "$lib/worktree" merge "$@" ;;
  init) exec "$lib/init" "$@" ;;
  skills) exec "$lib/skills" "$@" ;;
  name)
    [ -n "$TMUX_PANE" ] || die "run it in the tab you want to rename"
    new_name="${*//$'\t'/ }"
    [ -n "${new_name// /}" ] || die "usage: agvim name <text>"
    tmux rename-window -t "$TMUX_PANE" "$new_name"
    tmux set-option -w -t "$TMUX_PANE" @named 1
    ;;
  refresh) exec "$lib/project" refresh ;;
  save) exec "$lib/project" save-all ;;
  stop) exec "$lib/projects" stop --now ;;
  ai)
    parse "$@"
    case "$args[1]" in
      "")
        if [ -t 0 ]; then
          pick="$( { print -r -- "off${tab}Off"; grep -v '^#' "$lib/ai-providers.tsv" | cut -f1,2; } |
            fzf --delimiter="$tab" --with-nth=2 --height=~22 --reverse --no-info --prompt="now: $(ai_name)> ")" || exit 0
          args=("${pick%%$tab*}")
        else
          print -r -- "AI autocomplete: $(ai_name)"
          exit 0
        fi
        ;&
      *) ;;
    esac
    case "$args[1]" in
      signin) ai_signin ;;
      test)
        [ -n "$args[2]" ] && id="$args[2]" || id="$(ai_get use)"
        id="${id:-copilot}"
        if [ "$id" = copilot ]; then
          AGVIM_COPILOT_STATUS=1 nvim --headless -c "luafile $lib/copilot-signin.lua"
        elif [ "$id" = off ]; then
          print -r -- "AI autocomplete is off."
        else
          exec "$lib/ai-test" "$id"
        fi
        ;;
      list)
        print -r -- "Now: $(ai_name)"
        grep -v '^#' "$lib/ai-providers.tsv" | while IFS=$'\t' read -r id label kind url model; do
          if [ "$kind" = copilot ] || [ "$id" = freechain ] || [ -n "$(ai_get "key_$id")" ]; then state=ready; else state="needs key"; fi
          printf '%-11s %-10s %s\n' "$id" "$state" "$label"
        done
        ;;
      off)
        ai_set use off
        print -r -- "AI autocomplete is off."
        ai_apply
        ;;
      *)
        # Open Neovims restart only when the source really changed.
        ai_use "$args[1]" && ai_apply
        ;;
    esac
    ;;
  roots)
    roots_file=~/.config/agvim/roots
    if [ -n "$1" ]; then
      [ -n "$2" ] || die "usage: agvim roots [add|remove <folder>]"
      where="${2:A}"
      mkdir -p "${roots_file:h}"
      # Your list replaces the default one, so it starts from that.
      [ -f "$roots_file" ] || print -l ~/Projects ~/Developer ~/code ~/Desktop >"$roots_file"
      case "$1" in
        add)
          [ -d "$where" ] || die "no such folder: $2"
          grep -qxF -- "$where" "$roots_file" || print -r -- "$where" >>"$roots_file"
          ;;
        remove)
          updated="$(grep -vxF -- "$where" "$roots_file")"
          print -r -- "$updated" >"$roots_file"
          ;;
        *) die "usage: agvim roots [add|remove <folder>]" ;;
      esac
    fi
    if [ -f "$roots_file" ]; then cat "$roots_file"; else print -l ~/Projects ~/Developer ~/code ~/Desktop; fi
    ;;
  terminal)
    config=~/.config/agvim/terminal
    case "$1" in
      "") ;;
      auto) rm -f "$config" ;;
      *)
        app="$1"
        [[ "$app" == *.app ]] || app="$app.app"
        for dir in "" /Applications/ ~/Applications/ /System/Applications/Utilities/; do
          [ -d "$dir$app" ] && { app="$dir$app"; break; }
        done
        [ -d "$app" ] || die "no such app: $1"
        mkdir -p "${config:h}"
        print -r -- "${app:A}" >"$config"
        ;;
    esac
    "$lib/terminal" --which
    ;;
  diff) exec "$lib/gd" "$@" ;;
  folder)
    mkdir -p "$store"
    print -r -- "$store"
    open "$store"
    ;;
  update)
    # Saved projects are gitignored, so an update leaves them alone. Neovim rewrites its
    # plugin lockfile as it runs; the repo's copy decides the versions. The newest release,
    # or main while there are none.
    [ "$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null)" = main ] ||
      die "$repo isn't on the main branch: update it yourself (git merge), then run agvim update again"
    git -C "$repo" checkout -- nvim/lazy-lock.json 2>/dev/null
    git -C "$repo" fetch -q origin --tags 2>/dev/null
    latest="$(git -C "$repo" tag -l 'v*.*.*' --sort=-v:refname | head -1)"
    if [ -n "$latest" ]; then
      git -C "$repo" merge-base --is-ancestor "$latest" HEAD || git -C "$repo" merge --ff-only "$latest"
    else
      git -C "$repo" pull --ff-only
    fi
    if [ $? -ne 0 ]; then
      print -r -- "agvim: couldn't update $repo. Nothing was installed. Your own changes there may be in the way: see git status." >&2
      exit 1
    fi
    "$repo/install.sh" "$@" || exit 1
    "$lib/skills" update >/dev/null 2>&1
    "$lib/project" refresh
    print -r -- "Updated."
    if [ -n "$AGVIM_POPUP" ]; then
      print -rn -- "Press Enter to close. "
      read -r _
    fi
    ;;
  keep-running)
    case "$1" in
      on) rm -f "$keep_off" ;;
      off) mkdir -p "${keep_off:h}"; touch "$keep_off" ;;
      "") ;;
      *) die "usage: agvim keep-running [on|off]" ;;
    esac
    if [ -f "$keep_off" ]; then
      print -r -- "Closing the window stops every project (their tabs are saved)."
    else
      print -r -- "Closing the window keeps every project running; agvim stop stops them."
    fi
    ;;
  autoupdate)
    off=~/.config/agvim/auto-update-off
    case "$1" in
      on) rm -f "$off" ;;
      off) mkdir -p "${off:h}"; touch "$off" ;;
      "") ;;
      *) die "usage: agvim autoupdate [on|off]" ;;
    esac
    [ -f "$off" ] && print -r -- "Auto-update is off." || print -r -- "Auto-update is on."
    ;;
  release) exec "$repo/macos/release.sh" "$@" ;;
  uninstall) exec "$repo/uninstall.sh" "$@" ;;
  version | -v | --version)
    "$lib/banner"
    print -r -- "version $(git -C "$repo" describe --tags --always 2>/dev/null || print unknown)"
    ;;
  help | -h | --help) help ;;
  _p | _project | _projects | _open-project | _tab | _gd | _attention | _colours | _worktree | _send | _running | _skills | _init) exec "$lib/${cmd#_}" "$@" ;;
  *)
    print -r -- "agvim: no command called $cmd. See agvim help" >&2
    exit 1
    ;;
esac
