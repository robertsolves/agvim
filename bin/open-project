#!/bin/zsh
# open-project [dir]: open (or return to) the workspace for a project folder.
# Each project is a tab of the projects bar along the top (bin/projects), showing
# a tmux session of its own. In it, tmux's tabs along the bottom are full-screen
# windows: "nvim" (Neovim), then "shell 1", "shell 2"... (+ or Alt-t / Cmd-T adds
# one). Every window starts in the project folder. Projects keep running in tmux
# when kitty closes; opening kitty again shows them all.
# Used by `t`, `p`, tmux's prefix P, Finder's "Open in Neovim" Quick Action and
# folders dropped on kitty's Dock icon (--window: also bring kitty to the front).

kitten=/Applications/kitty.app/Contents/MacOS/kitten
unset TMUX # it may be the bar's; every tmux below is yours

window=0
if [ "$1" = --window ]; then
  window=1
  shift
fi
dir="${1:-$PWD}"
dir="${dir:A}" # absolute, symlinks resolved
if [ ! -d "$dir" ]; then
  dir="${dir:h}" # a file was given: use its folder
fi

name="${${dir:t}//[.:]/_}"
# Two projects with the same folder name get "parent_name" for the second one.
existing="$(tmux list-sessions -F '#{session_name}	#{session_path}' 2>/dev/null | awk -F'\t' -v n="$name" '$1 == n { print $2 }')"
if [ -n "$existing" ] && [ "$existing" != "$dir" ]; then
  name="${${dir:h:t}//[.:]/_}_$name"
fi

if ! tmux has-session -t "=$name" 2>/dev/null; then
  # "; true" keeps a shell above Neovim, so tmux-resurrect saves and restores it.
  tmux new-session -d -s "$name" -n nvim -c "$dir" "nvim .; true"
  tmux new-window -d -t "=$name:" -n "shell 1" -c "$dir"
fi
~/.local/bin/projects show "$name"

# Shown already when kitty (or another terminal) has the bar open.
if [ -n "$(tmux -L projects list-clients 2>/dev/null)" ]; then
  [ "$window" = 1 ] && open -a kitty
elif [ -n "$AW_NO_ATTACH" ]; then
  : # the bar's own picker: it attaches next
elif [ "$window" = 1 ]; then
  # A kitty window with the bar: in the running kitty (its remote control
  # socket, listen_on in kitty/agent-workspace.conf), else a new kitty.
  socket=""
  for s in /tmp/kitty-aw-*(N); do
    kill -0 "${s##*-}" 2>/dev/null && socket="unix:$s"
  done
  if [ -n "$socket" ]; then
    "$kitten" @ --to "$socket" launch --type=os-window --var aw_project=1 \
      /bin/zsh -lic 'exec ~/.local/bin/projects' >/dev/null
    open -a kitty
  else
    /Applications/kitty.app/Contents/MacOS/kitty >/dev/null 2>&1 &!
  fi
else
  exec ~/.local/bin/projects # in this terminal
fi
