#!/bin/zsh
# p: fuzzy-pick a project folder and open its tmux workspace (open-project).
# A project is a folder with .git, pubspec.yaml, Cargo.toml, Package.swift,
# pyproject.toml or package.json, up to 4 levels under the roots: one folder per
# line in ~/.config/agent-workspace/roots, else ~/Projects, ~/Developer, ~/code
# and ~/Desktop. Type to filter, Enter to open, Esc to cancel. `p flutter`
# starts filtered.

roots_file=~/.config/agent-workspace/roots
if [ -f "$roots_file" ]; then
  roots=(${(f)"$(sed "s#^~#$HOME#" "$roots_file")"})
else
  roots=(~/Projects ~/Developer ~/code ~/Desktop)
fi
roots=(${^roots}(N/)) # drop folders that don't exist
markers='^(\.git|pubspec\.yaml|Cargo\.toml|Package\.swift|pyproject\.toml|package\.json)$'

pick="$(
  fd --hidden --max-depth 5 --type d --type f \
     --exclude node_modules --exclude build --exclude target --exclude .dart_tool \
     --exclude .venv --exclude Pods --exclude .build --exclude .fvm --exclude ephemeral \
     "$markers" "${roots[@]}" 2>/dev/null |
    sed -E 's#/(\.git|[^/]+)/?$##' | sort -u | sed "s#^$HOME#~#" |
    fzf --query="$*" --height=60% --reverse --prompt="project> " \
        --preview='ls -A "$(eval echo {})" | head -40'
)"

[ -n "$pick" ] && exec open-project "${pick/#\~/$HOME}"
